# ---------------------------------------------------------------------
# Xwé IA — variables d'environnement
#
# Copier ce fichier en `.env` puis renseigner les valeurs.
# Le `.env` est ignoré par Git : aucun secret ne doit être commité.
#
# Toutes les variables ci-dessous restent côté serveur, à la seule
# exception de NEXT_PUBLIC_APP_URL qui ne contient aucun secret.
# Aucune clé d'API n'est exposée au navigateur.
# ---------------------------------------------------------------------

# --- Base de données (obligatoire) -----------------------------------
# PostgreSQL. En développement, `node scripts/dev-db.mjs` démarre une
# instance embarquée sur le port 5433 correspondant à cette URL.
DATABASE_URL="postgres://xwe:xwe@127.0.0.1:5433/xwe"


# --- Adresse publique du site (facultatif) ---------------------------
# Sert de base aux métadonnées et aux liens absolus.
# Défaut : http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- Intelligence artificielle (facultatif) --------------------------
# Sans clé, l'assistance IA bascule automatiquement sur le moteur local
# (`src/lib/ai/offline.ts`) : le produit reste fonctionnel, les réponses
# sont structurées mais non génératives. La page /admin/ia indique quelle
# origine est réellement utilisée.
#
# Le modèle est configurable exprès : les versions sont retirées avec le
# temps, il ne faut pas en figer une dans le code.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"


# --- Paiement Mobile Money -------------------------------------------
# La version 1 fonctionne en MoMo manuel : les numéros de réception se
# gèrent depuis /admin/paiements et aucune clé n'est nécessaire.
# La confirmation d'une commande est exclusivement serveur : la
# déclaration d'un utilisateur n'ouvre jamais d'accès à elle seule.
#
# Passer MOMO_API_ENABLED à "true" uniquement le jour où l'API MTN est
# réellement branchée et testée.
MOMO_API_ENABLED="false"
MOMO_API_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_API_KEY=""
MOMO_API_USER=""
MOMO_SUBSCRIPTION_KEY=""
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_CURRENCY="XOF"


# --- Amorçage des données (développement) ----------------------------
# Les comptes de démonstration ne sont créés qu'en développement.
# Mettre "true" pour forcer leur création en production (déconseillé).
SEED_DEMO_USERS="false"
