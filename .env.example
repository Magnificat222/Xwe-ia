# Base de données PostgreSQL (Neon, Supabase, Railway, RDS, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/mabidouz_ai_hub"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Kkiapay (préparation abonnement Premium — Mobile Money & cartes, Afrique de l'Ouest)
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY="ta-cle-publique-kkiapay"
KKIAPAY_PRIVATE_KEY="ta-cle-privee-kkiapay"
KKIAPAY_SECRET_KEY="ta-cle-secrete-kkiapay"
KKIAPAY_SANDBOX="true"
NEXT_PUBLIC_KKIAPAY_SANDBOX="true"

# OAuth providers (optionnel, à activer dans lib/auth.ts)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Resend (envoi d'e-mails : réinitialisation de mot de passe, formulaire de contact)
RESEND_API_KEY="re_xxx"

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_EMAIL="ton-email@exemple.com"

# Gemini (génération des questions de quiz et réponses du Salon Premium)
GEMINI_API_KEY="ta-cle-gemini"
