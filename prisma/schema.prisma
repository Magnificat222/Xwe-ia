// Xwé IA — Prisma schema
// Run `npx prisma db push` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MissionLevel {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hashed with bcrypt; null when using OAuth
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favorites     Favorite[]
  progress      Progress[]
  history       History[]
  subscription  Subscription?
  accounts      Account[]
  sessions      Session[]
  supportMessages SupportMessage[]
  quizAttempts     QuizAttempt[]
  duelsAsChallenger Duel[] @relation("DuelChallenger")
  duelsAsOpponent   Duel[] @relation("DuelOpponent")
}

// --- NextAuth / Auth.js required models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
// --- end Auth.js models ---

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  icon        String
  missions    Mission[]
}

model Mission {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  description       String       @db.Text
  level             MissionLevel @default(DEBUTANT)
  estimatedMinutes  Int
  recommendedTools  String[] // Tool ids, denormalized for quick display
  steps             Json // MissionStep[]
  tips              String[]
  commonMistakes    String[]
  checklist         String[]
  isPremium         Boolean      @default(false)
  isPublished       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  paths      LearningPathMission[]
  favorites  Favorite[]
  progress   Progress[]
  history    History[]
}

model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  isPremium   Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  missions  LearningPathMission[]
  favorites Favorite[]
}

// Explicit join table so missions can be ordered within a path
model LearningPathMission {
  id             String       @id @default(cuid())
  order          Int
  learningPathId String
  missionId      String

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, missionId])
}

model Prompt {
  id               String   @id @default(cuid())
  title            String
  content          String   @db.Text
  tags             String[]
  isPremium        Boolean  @default(false)
  recommendedTools String[] // Tool ids most effective for this prompt
  createdAt        DateTime @default(now())

  categoryId String
  favorites  Favorite[]
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  useCases    String[]
  pricing     String
  features    String[]
  url         String
  howToUse    String[] // short step-by-step usage guide

  favorites Favorite[]
}

// Polymorphic-style favorites: exactly one target field is set per row.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  missionId      String?
  learningPathId String?
  promptId       String?
  toolId         String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission      Mission?      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  prompt       Prompt?       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tool         Tool?         @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model History {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared group chat for all Premium members ("Salon Premium"). Every
// Premium user and the admin post into the same feed; Gemini also auto-
// replies as a first responder (see lib/gemini.ts).
model SupportMessage {
  id         String         @id @default(cuid())
  authorId   String?
  authorName String
  senderRole ChatSenderRole
  content    String         @db.Text
  createdAt  DateTime       @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

enum ChatSenderRole {
  USER
  ADMIN
  AI
}

// Downloadable PDF guides, gated to Premium members (+ admin). The actual
// PDF files live in /content/ebooks (outside /public, so they can't be
// downloaded directly without going through the authenticated API route).
model Ebook {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  fileName    String // filename inside /content/ebooks
  pageCount   Int?
  isPremium   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

enum QuizBadgeTier {
  BRONZE
  SILVER
  GOLD
}

enum DuelMode {
  ASYNC
  LIVE
}

enum DuelStatus {
  PENDING // challenge sent, waiting for the opponent to play
  IN_PROGRESS // reserved for LIVE mode (not yet implemented)
  COMPLETED
  DECLINED
  EXPIRED
}

// A themed level of the Quiz Arena — e.g. "Bases de l'IA". Each stage is
// played in sets of (at least) 10 questions, generated fresh by Gemini
// every time so the same 10 questions don't keep coming back.
model QuizStage {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  description   String       @db.Text
  topic         String // seed fed to Gemini to keep generated questions on-theme
  level         MissionLevel @default(DEBUTANT)
  order         Int          @default(0)
  questionCount Int          @default(10)
  isPremium     Boolean      @default(false)
  createdAt     DateTime     @default(now())

  attempts QuizAttempt[]
  duels    Duel[]
}

// One playthrough of a stage: a freshly-generated question set plus the
// user's answers, score and timing.
model QuizAttempt {
  id              String         @id @default(cuid())
  userId          String
  stageId         String
  questions       Json // generated QuizQuestionData[] (includes correct answer + explanation)
  answers         Json? // number[] while in progress / once submitted
  score           Int            @default(0) // points from correct answers
  speedBonus      Int            @default(0)
  totalScore      Int            @default(0)
  badge           QuizBadgeTier?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage QuizStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  duelAsChallenger Duel[] @relation("ChallengerAttempt")
  duelAsOpponent   Duel[] @relation("OpponentAttempt")

  @@index([userId])
  @@index([stageId])
}

// A 1v1 challenge on a given stage. Async today (each plays on their own
// time, then scores are compared); the `mode` field already distinguishes
// LIVE so a real-time version can be added later without a schema change.
model Duel {
  id                  String     @id @default(cuid())
  stageId             String
  mode                DuelMode   @default(ASYNC)
  status              DuelStatus @default(PENDING)
  challengerId        String
  opponentId          String
  challengerAttemptId String?    @unique
  opponentAttemptId   String?    @unique
  winnerId            String?
  createdAt           DateTime   @default(now())
  respondedAt         DateTime?
  completedAt         DateTime?

  stage             QuizStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  challenger        User         @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent          User         @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  challengerAttempt QuizAttempt? @relation("ChallengerAttempt", fields: [challengerAttemptId], references: [id], onDelete: SetNull)
  opponentAttempt   QuizAttempt? @relation("OpponentAttempt", fields: [opponentAttemptId], references: [id], onDelete: SetNull)

  @@index([challengerId])
  @@index([opponentId])
}
