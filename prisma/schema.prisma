// Xwé IA — Prisma schema
// Schema changes go through `prisma migrate` (see MIGRATIONS.md). Never `db push` on production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum MissionLevel {
  DEBUTANT
  INTERMEDIAIRE
  AVANCE
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}


// --- Parcours / Xwé Crédits / paiements manuels ---
enum PathAccessType {
  FREE // open to any logged-in user
  PREMIUM // open while the user has an ACTIVE, non-expired Premium subscription
  CREDITS // must be unlocked once with Xwé Crédits (or granted by an admin)
}

// How a stored PathAccess row was obtained. FREE / PREMIUM access is never
// stored: it is computed from the path + subscription, so it expires correctly.
enum PathAccessSource {
  CREDITS
  ADMIN_GRANT
}

enum CreditTransactionType {
  PURCHASE // +, credits bought through an approved PaymentRequest
  SPEND // -, credits spent to unlock a path
  ADMIN_CREDIT // +, manual admin adjustment (reason required)
  ADMIN_DEBIT // -, manual admin adjustment (reason required)
  REFUND // +, compensation for a failed or cancelled spend
}

enum PaymentProvider {
  MTN_MOMO
  CELTIS_MONEY
}

enum PaymentPurpose {
  CREDIT_PACK
  PREMIUM
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hashed with bcrypt; null when using OAuth
  image         String?
  role          Role      @default(USER)
  dashboardPrefs Json?    // which dashboard sections are shown, and in what order
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favorites     Favorite[]
  progress      Progress[]
  history       History[]
  subscription  Subscription?
  accounts      Account[]
  sessions      Session[]
  supportMessages SupportMessage[]
  quizAttempts     QuizAttempt[]
  duelsAsChallenger Duel[] @relation("DuelChallenger")
  duelsAsOpponent   Duel[] @relation("DuelOpponent")
  notifications     Notification[]
  guidedProjects    GuidedProject[]
  creditAccount     CreditAccount?
  pathAccesses      PathAccess[]
  paymentRequests   PaymentRequest[]
  kkiapayTransactions KkiapayTransaction[]
}

// --- NextAuth / Auth.js required models ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
// --- end Auth.js models ---

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  icon        String
  missions    Mission[]
  paths       LearningPath[]
}

model Mission {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  description       String       @db.Text
  level             MissionLevel @default(DEBUTANT)
  estimatedMinutes  Int
  recommendedTools  String[] // Tool ids, denormalized for quick display
  steps             Json // MissionStep[]
  tips              String[]
  commonMistakes    String[]
  checklist         String[]
  isPremium         Boolean      @default(false)
  isPublished       Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  paths      LearningPathMission[]
  favorites  Favorite[]
  progress   Progress[]
  history    History[]
}

model LearningPath {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  // DEPRECATED: kept so existing code keeps compiling. `accessType` is the
  // source of truth. Migration 20260930120000 copies isPremium -> accessType.
  isPremium   Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())

  // --- Parcours v2 (all additive, all defaulted) ---
  accessType       PathAccessType @default(FREE)
  creditCost       Int            @default(0) // only meaningful when accessType = CREDITS
  categoryId       String?
  difficulty       MissionLevel   @default(DEBUTANT)
  estimatedMinutes Int?
  resultSummary    String?        @db.Text // "à la fin tu auras..."
  deliverableType  String? // e.g. "docx", "plan d'action"
  wizardType       String? // keys into lib/wizards (e.g. "business-plan")
  displayOrder     Int            @default(0)
  updatedAt        DateTime       @default(now()) @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  missions       LearningPathMission[]
  favorites      Favorite[]
  accesses       PathAccess[]
  guidedProjects GuidedProject[]

  @@index([isPublished, displayOrder])
}

// Explicit join table so missions can be ordered within a path
model LearningPathMission {
  id             String       @id @default(cuid())
  order          Int
  learningPathId String
  missionId      String

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  mission      Mission      @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, missionId])
}

model Prompt {
  id               String   @id @default(cuid())
  title            String
  content          String   @db.Text
  tags             String[]
  isPremium        Boolean  @default(false)
  recommendedTools String[] // Tool ids most effective for this prompt
  createdAt        DateTime @default(now())

  categoryId String
  favorites  Favorite[]
}

model Tool {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  useCases    String[]
  pricing     String
  features    String[]
  url         String
  howToUse    String[] // short step-by-step usage guide

  favorites Favorite[]
}

// Polymorphic-style favorites: exactly one target field is set per row.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  missionId      String?
  learningPathId String?
  promptId       String?
  toolId         String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission      Mission?      @relation(fields: [missionId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  prompt       Prompt?       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tool         Tool?         @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  missionId   String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model History {
  id        String   @id @default(cuid())
  userId    String
  missionId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  // null currentPeriodEnd on a PREMIUM row = NOT active (no lifetime Premium any
  // more; the migration gave every legacy row an end date). See lib/subscription.ts.
  startedAt            DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Shared group chat for all Premium members ("Salon Premium"). Every
// Premium user and the admin post into the same feed; Gemini also auto-
// replies as a first responder (see lib/gemini.ts).
model SupportMessage {
  id         String         @id @default(cuid())
  authorId   String?
  authorName String
  senderRole ChatSenderRole
  content    String         @db.Text
  imageUrl   String?        @db.Text // base64 data URL, resized client-side before send
  editedAt   DateTime?
  replyToId  String?
  createdAt  DateTime       @default(now())

  author  User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  replyTo SupportMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies SupportMessage[] @relation("MessageReplies")

  @@index([createdAt])
}

enum ChatSenderRole {
  USER
  ADMIN
  AI
}

// Downloadable PDF guides, gated to Premium members (+ admin). The actual
// PDF files live in /content/ebooks (outside /public, so they can't be
// downloaded directly without going through the authenticated API route).
model Ebook {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @db.Text
  fileName    String? // filename inside /content/ebooks (seeded ebooks only)
  fileData    String?  @db.Text // base64 PDF data (ebooks added from the admin panel)
  pageCount   Int?
  isPremium   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

enum QuizBadgeTier {
  BRONZE
  SILVER
  GOLD
}

enum DuelMode {
  ASYNC
  LIVE
}

enum DuelStatus {
  PENDING // challenge sent, waiting for the opponent to play
  IN_PROGRESS // reserved for LIVE mode (not yet implemented)
  COMPLETED
  DECLINED
  EXPIRED
}

// A themed level of the Quiz Arena — e.g. "Bases de l'IA". Each stage is
// played in sets of (at least) 10 questions, generated fresh by Gemini
// every time so the same 10 questions don't keep coming back.
model QuizStage {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  description   String       @db.Text
  topic         String // seed fed to Gemini to keep generated questions on-theme (used when questionSource is AI)
  level         MissionLevel @default(DEBUTANT)
  order         Int          @default(0)
  questionCount Int          @default(10)
  questionSource QuizQuestionSource @default(AI)
  isPremium     Boolean      @default(false)
  createdAt     DateTime     @default(now())

  attempts        QuizAttempt[]
  duels           Duel[]
  manualQuestions QuizQuestion[]
}

enum QuizQuestionSource {
  AI // generated fresh by Gemini every attempt, from `topic`
  MANUAL // drawn at random from this stage's hand-written question bank
}

// A hand-written question for a stage using QuizQuestionSource.MANUAL. If a
// stage has more questions in its bank than its questionCount, a fresh
// random subset is drawn each attempt — so it still doesn't feel like the
// same 10 questions every time, even without AI generation.
model QuizQuestion {
  id            String   @id @default(cuid())
  stageId       String
  question      String   @db.Text
  options       String[] // exactly 4
  correctIndex  Int // 0-3
  explanation   String   @db.Text
  createdAt     DateTime @default(now())

  stage QuizStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

// One playthrough of a stage: a freshly-generated question set plus the
// user's answers, score and timing.
model QuizAttempt {
  id              String         @id @default(cuid())
  userId          String
  stageId         String
  questions       Json // generated QuizQuestionData[] (includes correct answer + explanation)
  answers         Json? // number[] while in progress / once submitted
  score           Int            @default(0) // points from correct answers
  speedBonus      Int            @default(0)
  totalScore      Int            @default(0)
  badge           QuizBadgeTier?
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage QuizStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  duelAsChallenger Duel[] @relation("ChallengerAttempt")
  duelAsOpponent   Duel[] @relation("OpponentAttempt")

  @@index([userId])
  @@index([stageId])
}

// A 1v1 challenge on a given stage. Async today (each plays on their own
// time, then scores are compared); the `mode` field already distinguishes
// LIVE so a real-time version can be added later without a schema change.
model Duel {
  id                  String     @id @default(cuid())
  stageId             String
  mode                DuelMode   @default(ASYNC)
  status              DuelStatus @default(PENDING)
  challengerId        String
  opponentId          String
  challengerAttemptId String?    @unique
  opponentAttemptId   String?    @unique
  winnerId            String?
  createdAt           DateTime   @default(now())
  respondedAt         DateTime?
  completedAt         DateTime?

  stage             QuizStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  challenger        User         @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent          User         @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  challengerAttempt QuizAttempt? @relation("ChallengerAttempt", fields: [challengerAttemptId], references: [id], onDelete: SetNull)
  opponentAttempt   QuizAttempt? @relation("OpponentAttempt", fields: [opponentAttemptId], references: [id], onDelete: SetNull)

  @@index([challengerId])
  @@index([opponentId])
}

// Singleton row (id is always "singleton") holding site-wide settings the
// admin can adjust without touching code — e.g. the Premium price.
model SiteSettings {
  id                     String  @id @default("singleton")
  premiumPriceXof        Int     @default(5795)
  // While false, the public KKiaPay checkout is hidden and Premium access
  // is granted manually by an admin (Admin → Utilisateurs) — useful for a
  // controlled beta before opening self-serve payment to everyone.
  selfServePremiumEnabled Boolean @default(true)

  // Manual commercial payments (MTN Mobile Money / Celtis Money). Payment
  // numbers live here, editable by the admin, never hard-coded.
  manualPaymentsEnabled  Boolean @default(false)
  mtnMomoNumber          String?
  mtnMomoAccountName     String?
  celtisMoneyNumber      String?
  celtisMoneyAccountName String?
  paymentInstructions    String? @db.Text
  premiumDurationDays    Int     @default(31) // one Premium payment = 31 days
}

enum NotificationType {
  CHAT_REPLY
  DUEL_CHALLENGE
  DUEL_RESULT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  link      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// A guided, multi-step project wizard (e.g. "business-plan"). `wizardType`
// keys into a config defined in code (lib/wizards/*) — the steps and fields
// themselves aren't in the DB, only each user's own answers are. No AI is
// involved: the final document assembles the user's own words, formatted.
model GuidedProject {
  id          String    @id @default(cuid())
  userId      String
  wizardType  String
  title       String?
  answers     Json      @default("{}")
  currentStep Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Optional link to the path this wizard belongs to (Business Plan path).
  learningPathId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([learningPathId])
}

// ---------------------------------------------------------------------------
// Xwé Crédits
// ---------------------------------------------------------------------------

// Credit packs sold through manual payments. Editable in DB (future admin UI)
// so prices/amounts never require a code change.
model CreditPack {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. "pack-starter"
  name         String
  credits      Int
  priceXof     Int
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentRequests PaymentRequest[]
}

// One balance per user. The balance is only ever changed by lib/credits.ts,
// inside a DB transaction that also writes the CreditTransaction row.
// userId becomes NULL (not deleted) if the user is deleted, so the financial
// history survives; ownerEmail is a snapshot for traceability.
model CreditAccount {
  id         String   @id @default(cuid())
  userId     String?  @unique
  ownerEmail String?
  balance    Int      @default(0) // DB CHECK (balance >= 0), see migration
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions CreditTransaction[]
}

// Append-only ledger. A DB trigger rejects UPDATE and DELETE (see migration).
// `amount` is signed; balanceAfter lets the balance be audited line by line.
model CreditTransaction {
  id               String                @id @default(cuid())
  accountId        String
  type             CreditTransactionType
  amount           Int
  balanceAfter     Int
  description      String?
  reason           String? // mandatory for ADMIN_* (enforced in code)
  idempotencyKey   String?               @unique
  paymentRequestId String?               @unique // a payment can credit only once
  learningPathId   String? // snapshot, no FK (ledger is immutable)
  createdById      String? // admin who triggered it, no FK (ledger is immutable)
  createdAt        DateTime              @default(now())

  account        CreditAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: Restrict)
  pathAccess     PathAccess?

  @@index([accountId, createdAt])
}

// A user's claim "I paid X via MTN/Celtis, reference Y". Nothing is granted
// until an admin approves it after checking the SMS on the merchant account.
// amountXof / creditAmount / premiumMonths are computed SERVER-side.
model PaymentRequest {
  id              String          @id @default(cuid())
  userId          String?
  purpose         PaymentPurpose
  provider        PaymentProvider
  packId          String?
  amountXof       Int
  creditAmount    Int? // CREDIT_PACK
  premiumMonths   Int? // PREMIUM
  payerPhone      String
  transactionRef  String // normalized (trim + uppercase) before insert
  proofUrl        String?
  status          PaymentStatus   @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  pack        CreditPack?        @relation(fields: [packId], references: [id], onDelete: SetNull)
  transaction CreditTransaction?

  @@unique([provider, transactionRef])
  @@index([status, createdAt])
  @@index([userId])
}

// One row per Kkiapay transaction that has been turned into Premium. The
// UNIQUE index on transactionId is what makes a transaction usable only once:
// the row is inserted in the SAME DB transaction as the Premium extension, so
// two concurrent requests for the same transactionId cannot both succeed.
// userId is SetNull on user deletion so the transactionId stays burned.
model KkiapayTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  userId        String?
  amountXof     Int
  premiumDays   Int
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// Fixed-window counters used by lib/rate-limit.ts (abuse brake only).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Explicit grants only (bought with credits, or given by an admin). FREE and
// PREMIUM paths have no row: their access is computed live, so a Premium
// expiry takes effect immediately.
model PathAccess {
  id                  String           @id @default(cuid())
  userId              String
  learningPathId      String
  source              PathAccessSource
  creditsSpent        Int              @default(0)
  creditTransactionId String?          @unique
  grantedById         String?
  createdAt           DateTime         @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath      LearningPath       @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  creditTransaction CreditTransaction? @relation(fields: [creditTransactionId], references: [id], onDelete: Restrict)

  @@unique([userId, learningPathId])
  @@index([learningPathId])
}
